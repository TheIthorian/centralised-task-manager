{
    "name": "ctm",
    "private": true,
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "test": "turbo test",
        "lint": "turbo lint",
        "format": "oxfmt --config .oxfmtrc.json '*.md' '.claude/**/*.md' '.claude/*.json' && turbo format"
    },
    "devDependencies": {
        "oxfmt": "0.51.0",
        "oxlint": "1.66.0",
        "turbo": "2.9.14",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=9.0.0"
    },
    "packageManager": "pnpm@11.1.3"
}
