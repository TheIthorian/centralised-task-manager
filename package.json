{
    "name": "ctm",
    "private": true,
    "scripts": {
        "build": "turbo build",
        "ctm": "pnpm -s --filter @ctm/cli ctm",
        "dev": "turbo dev",
        "test": "turbo test",
        "lint": "turbo lint",
        "format": "oxfmt --config .oxfmtrc.json '*.md' '.claude/**/*.md' '.claude/*.json' && turbo format"
    },
    "devDependencies": {
        "fastify": "5.12.5",
        "oxfmt": "0.60.0",
        "oxlint": "1.75.0",
        "turbo": "2.10.13",
        "typescript": "6.0.3",
        "wrangler": "^4.133.0"
    },
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=9.0.0"
    },
    "packageManager": "pnpm@11.1.3"
}
