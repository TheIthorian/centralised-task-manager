        "@nestjs/platform-fastify": "11.1.28",
        "@nestjs/testing": "11.2.1",
        "@swc/core": "1.16.22",
        "@types/node": "26.6.6",
        "fastify": "5.12.8",
        "mongoose": "9.8.0",
