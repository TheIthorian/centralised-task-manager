{
    "name": "@ctm/api-client",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch",
        "test": "vitest run",
        "lint": "oxlint .",
        "format": "oxfmt --config ../../.oxfmtrc.json . '**/*.md'"
    },
    "dependencies": {
        "axios": "1.18.1"
    },
    "devDependencies": {
        "@ctm/tsconfig": "workspace:*",
        "typescript": "7.0.2",
        "vitest": "4.1.10"
    }
}
