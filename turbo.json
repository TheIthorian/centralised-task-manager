{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "12",
  "tasks": {
    "generate-openapi": {
      "outputs": ["openapi.json"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".docusaurus/**"]
    },
    "@ctm/docs#build": {
      "dependsOn": ["@ctm/main#generate-openapi", "^build"],
      "outputs": ["build/**", ".docusaurus/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "format": {},
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
