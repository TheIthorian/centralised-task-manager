{
    "$schema": "https://turbo.build/schema.json",
    "concurrency": "24",
    "tasks": {
        "generate-openapi": {
            "dependsOn": ["^build"],
            "outputs": ["openapi.json"]
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "build/**", ".docusaurus/**"]
        },
        "bundle": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"],
            "env": ["CTM_DEFAULT_BASE_URL"]
        },
        "@ctm/docs#build": {
            "dependsOn": ["^build", "@ctm/main#generate-openapi"],
            "outputs": ["build/**", ".docusaurus/**"],
            "env": ["DOCS_URL"]
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "lint": {},
        "format": {},
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "@ctm/docs#dev": {
            "dependsOn": ["@ctm/main#generate-openapi"],
            "cache": false,
            "persistent": true
        }
    }
}
