{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "apps/mcp/Dockerfile",
        "watchPatterns": [
            "apps/mcp/**",
            "packages/api-client/**",
            "packages/logger/**",
            "packages/request-logger/**",
            "packages/tsconfig/**",
            "package.json",
            "pnpm-lock.yaml",
            "pnpm-workspace.yaml",
            "turbo.json",
            "railway.mcp.json"
        ]
    },
    "deploy": {
        "healthcheckPath": "/health",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10,
        "numReplicas": 1
    }
}
