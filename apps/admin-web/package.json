{
    "name": "@ctm/admin-web",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -p tsconfig.build.json && tsc -p functions/tsconfig.json && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "typecheck:functions": "tsc -p functions/tsconfig.json",
        "lint": "oxlint .",
        "format": "oxfmt --config ../../.oxfmtrc.json . '**/*.md'"
    },
    "dependencies": {
        "@ctm/api-client": "workspace:*",
        "@ctm/ui": "workspace:*",
        "@tanstack/react-query": "5.101.4",
        "clsx": "2.1.1",
        "i18next": "26.3.6",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-i18next": "17.0.11",
        "react-router": "8.3.0"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "5.20260827.1",
        "@ctm/tsconfig": "workspace:*",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.6",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "@vitejs/plugin-react": "6.1.0",
        "jsdom": "30.0.1",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "vite": "8.2.2",
        "vite-plugin-svgr": "5.2.0",
        "vitest": "4.1.11"
    }
}
