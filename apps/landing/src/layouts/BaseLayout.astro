---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CTM — Centralised Task Manager',
  description = 'Connect Todoist, Google Tasks, and more. Manage all your tasks from a single dashboard, CLI, or AI agent.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!--
      Blocking on purpose: the theme class has to be on <html> before first paint, or a
      dark-mode visitor gets a white flash. `theme` is the key apps/web writes, so a choice
      made in the app carries across when the two are served from one origin.
    -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="bg-bg text-fg antialiased">
    <slot />
  </body>
</html>
