{
  "name": "@ctm/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "ctm": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch -r ./register.cjs src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "lint": "oxlint src",
    "format": "oxfmt --config ../../.oxfmtrc.json src '**/*.md'"
  },
  "dependencies": {
    "@ctm/api-client": "workspace:*",
    "@inquirer/prompts": "^7.5.3",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0",
    "open": "^10.1.2"
  },
  "devDependencies": {
    "@ctm/tsconfig": "workspace:*",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
