{
    "name": "@ctm/cli",
    "version": "0.0.1",
    "private": true,
    "bin": {
        "ctm": "./dist/main.js"
    },
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "ctm": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./dev-loader.mjs src/main.ts",
        "bundle": "node scripts/bundle.mjs",
        "test": "vitest run",
        "lint": "oxlint .",
        "format": "oxfmt --no-error-on-unmatched-pattern --config ../../.oxfmtrc.json src '**/*.md'"
    },
    "dependencies": {
        "@ctm/api-client": "workspace:*",
        "@ctm/errors": "workspace:*",
        "@inquirer/prompts": "8.5.2",
        "cli-table3": "0.6.5",
        "commander": "15.0.0",
        "open": "11.0.0"
    },
    "devDependencies": {
        "@ctm/tsconfig": "workspace:*",
        "@swc/core": "1.16.0",
        "@types/node": "26.2.0",
        "esbuild": "0.28.2",
        "ts-node": "10.9.2",
        "typescript": "6.0.3",
        "unplugin-swc": "1.5.11",
        "vitest": "5.0.1"
    }
}
