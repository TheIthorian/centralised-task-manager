{
    "name": "@ctm/docs",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "start": "docusaurus start",
        "dev": "docusaurus gen-api-docs all && docusaurus start --port 3001",
        "build": "docusaurus gen-api-docs all && docusaurus build",
        "clean": "docusaurus clear",
        "generate": "docusaurus gen-api-docs all",
        "lint": "echo 'no lint'",
        "format": "oxfmt --config ../../.oxfmtrc.json '**/*.md'"
    },
    "dependencies": {
        "@docusaurus/core": "3.10.2",
        "@docusaurus/faster": "3.10.2",
        "@docusaurus/preset-classic": "3.10.2",
        "@docusaurus/theme-common": "3.10.2",
        "clsx": "2.1.1",
        "docusaurus-plugin-openapi-docs": "5.1.2",
        "docusaurus-theme-openapi-docs": "5.1.2",
        "prism-react-renderer": "2.4.1",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@docusaurus/module-type-aliases": "3.10.2",
        "@docusaurus/types": "3.10.2",
        "@types/react": "19.2.18",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
