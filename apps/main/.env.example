MONGODB_URI=mongodb://localhost:27017/ctm
JWT_SECRET=<at-least-32-chars>
ENCRYPTION_KEY=<64-hex-chars>
PORT=3000
NODE_ENV=development

TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

REDIRECT_BASE_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# CORS — comma-separated origins, or omit/set to * to allow all (dev default)
# CORS_ORIGIN=https://app.example.com,https://www.example.com

RSA_PRIVATE_KEY=<base64-encoded PKCS8 private key PEM>
RSA_PUBLIC_KEY=<base64-encoded SPKI public key PEM>
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
