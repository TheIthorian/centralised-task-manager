# Database
MONGODB_URI=mongodb://localhost:27017/ctm

# Auth — JWT_SECRET min 32 chars; RSA keys base64-encoded PEM; JWT_ACCESS_EXPIRES in seconds
JWT_SECRET=<at-least-32-chars>
JWT_ACCESS_EXPIRES=120
REFRESH_TOKEN_EXPIRES_DAYS=30
RSA_PRIVATE_KEY=<base64-encoded PKCS8 private key PEM>
RSA_PUBLIC_KEY=<base64-encoded SPKI public key PEM>

# Encryption — must match apps/sync; AES-256 requires 64 hex chars
ENCRYPTION_KEY=<64-hex-chars>

# Server
PORT=3000
NODE_ENV=development
REDIRECT_BASE_URL=http://localhost:3000
WEB_URL=http://localhost:5173
# Advertised to MCP clients by the web UI; must match apps/mcp MCP_PUBLIC_URL
MCP_PUBLIC_URL=http://localhost:3002
LOG_LEVEL=info
EXPORT_DIR=./exports

# Path the refresh cookie is scoped to, as the BROWSER sees it. With the /api
# proxy in front of this service that is /api/auth, not /auth. Must cover both
# /api/auth/refresh AND /api/auth/logout, or the browser never sends the
# cookie to logout and the DB record is never revoked (RFC 6265 §5.1.4 path match).
COOKIE_PATH=/api/auth
# Must be true in production. false locally, because http://localhost drops Secure cookies.
COOKIE_SECURE=false

# CORS — comma-separated origins; omit to allow all (dev default)
# CORS_ORIGIN=https://app.example.com,https://www.example.com

# Fair-usage rate limits. Counted per authenticated user, or per client IP for
# anonymous traffic. The STRICT_ pair applies to the unauthenticated abuse surface
# (login, register, refresh, OAuth token) and is counted per route.
# All values below are optional — these are the schema defaults.
RATE_LIMIT_BURST_PER_MINUTE=60
RATE_LIMIT_SUSTAINED_PER_HOUR=1000
RATE_LIMIT_STRICT_BURST_PER_MINUTE=10
RATE_LIMIT_STRICT_SUSTAINED_PER_HOUR=100

# Token refresh is paced by expiring access tokens, so it gets its own bucket
RATE_LIMIT_REFRESH_BURST_PER_MINUTE=30
RATE_LIMIT_REFRESH_SUSTAINED_PER_HOUR=600

# Account lockout after consecutive failed logins
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Per-account resource caps
MAX_CONNECTIONS_PER_CONNECTOR=5
MAX_TASKS_PER_USER=10000

# Todoist OAuth
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# Google Tasks OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Notion OAuth
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Production (Railway service: "main") — set these as Railway variables.
#
#   PORT=3000                                           # set explicitly so the mcp
#                                                       # service can address it privately
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ctm?retryWrites=true&w=majority
#   NODE_ENV=production
#   LOG_LEVEL=info
#   REDIRECT_BASE_URL=https://<main>.up.railway.app     # OAuth callbacks land here
#   WEB_URL=https://app.<domain>                        # Cloudflare Pages SPA
#   MCP_PUBLIC_URL=https://<mcp>.up.railway.app         # same value as the mcp service
#   CORS_ORIGIN=https://app.<domain>                    # comma-separated; no '*' in prod
#   EXPORT_DIR=/data/exports                            # Railway volume mount path
#   COOKIE_PATH=/api/auth
#   COOKIE_SECURE=true
#   JWT_SECRET / ENCRYPTION_KEY / RSA_PRIVATE_KEY / RSA_PUBLIC_KEY — same format as above
#   RATE_LIMIT_* / LOGIN_* / MAX_* — optional; set only to override the defaults.
#                                    The rate limiter counts in-process, so keep the
#                                    service on one replica until a shared store exists
#
# Every TODOIST_/GOOGLE_/DISCORD_/NOTION_ variable above must be present in
# production too — the connectors module reads them with getOrThrow, so set an
# empty string for connectors you are not using.
#
# The OAuth apps (Todoist, Google, Discord, Notion) each need
# `${REDIRECT_BASE_URL}/connectors/oauth/callback/<name>` added as a redirect URI.
# ---------------------------------------------------------------------------
