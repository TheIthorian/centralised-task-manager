{
  "name": "@ctm/main",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --watch -r ./register.cjs src/main.ts",
    "test": "vitest run",
    "lint": "oxlint src",
    "format": "oxfmt --config ../../.oxfmtrc.json src '**/*.md'",
    "generate-openapi": "tsc -p tsconfig.scripts.json && node dist/scripts/generate-openapi.js"
  },
  "dependencies": {
    "@ctm/api-client": "workspace:*",
    "@ctm/connectors": "workspace:*",
    "@ctm/errors": "workspace:*",
    "@ctm/http-client": "workspace:*",
    "@ctm/logger": "workspace:*",
    "@ctm/request-logger": "workspace:*",
    "@fastify/cors": "11.2.0",
    "@fastify/formbody": "8.0.2",
    "@nestjs/common": "11.1.21",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.21",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-fastify": "11.1.21",
    "@nestjs/platform-socket.io": "11.1.21",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.3",
    "@nestjs/websockets": "11.1.21",
    "ajv": "^8.20.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "joi": "17.13.3",
    "mongoose": "9.6.2",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@ctm/tsconfig": "workspace:*",
    "@nestjs/testing": "11.1.21",
    "@swc/core": "1.15.33",
    "@types/bcrypt": "6.0.0",
    "@types/node": "17.0.45",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "fastify": "5.8.5",
    "ts-node": "10.9.2",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "unplugin-swc": "1.5.9",
    "vitest": "4.1.7"
  }
}
