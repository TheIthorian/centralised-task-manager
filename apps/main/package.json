{
  "name": "@ctm/main",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "lint": "oxlint src",
    "format": "oxfmt --config ../../oxfmt.json src",
    "generate-openapi": "tsc -p tsconfig.scripts.json && node dist/scripts/generate-openapi.js"
  },
  "dependencies": {
    "@ctm/connectors": "workspace:*",
    "@ctm/errors": "workspace:*",
    "@ctm/logger": "workspace:*",
    "@fastify/formbody": "^8.0.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/swagger": "^11.4.3",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "joi": "^17.13.3",
    "mongoose": "^8.13.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@ctm/tsconfig": "workspace:*",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.11.24",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.15.21",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "fastify": "^5.8.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.2.0"
  }
}
