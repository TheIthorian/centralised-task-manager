{
    "name": "@ctm/main",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/main.js",
        "dev": "node --watch -r ./register.cjs src/main.ts",
        "test": "vitest run",
        "lint": "oxlint .",
        "format": "oxfmt --config ../../.oxfmtrc.json .",
        "generate-openapi": "tspc -p tsconfig.scripts.json && node dist-scripts/scripts/generate-openapi.js"
    },
    "dependencies": {
        "@ctm/api-client": "workspace:*",
        "@ctm/connectors": "workspace:*",
        "@ctm/db": "workspace:*",
        "@ctm/domain": "workspace:*",
        "@ctm/env": "workspace:*",
        "@ctm/errors": "workspace:*",
        "@ctm/http-client": "workspace:*",
        "@ctm/logger": "workspace:*",
        "@ctm/nest-common": "workspace:*",
        "@ctm/request-logger": "workspace:*",
        "@fastify/compress": "9.1.0",
        "@fastify/cookie": "11.0.2",
        "@fastify/cors": "11.3.0",
        "@fastify/formbody": "8.0.2",
        "@fastify/multipart": "^10.1.0",
        "@nestjs/common": "11.1.28",
        "@nestjs/config": "4.0.4",
        "@nestjs/core": "11.1.28",
        "@nestjs/jwt": "11.0.2",
        "@nestjs/mongoose": "11.0.4",
        "@nestjs/passport": "11.0.5",
        "@nestjs/platform-fastify": "11.1.28",
        "@nestjs/platform-socket.io": "11.1.28",
        "@nestjs/schedule": "6.1.3",
        "@nestjs/swagger": "11.4.6",
        "@nestjs/throttler": "6.5.0",
        "@nestjs/websockets": "11.1.28",
        "ajv": "^8.20.0",
        "bcrypt": "6.0.0",
        "joi": "18.2.3",
        "mongoose": "9.8.0",
        "nestjs-zod": "5.5.0",
        "passport": "0.7.0",
        "passport-jwt": "4.0.1",
        "passport-local": "1.0.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "socket.io": "4.8.3",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@ctm/tsconfig": "workspace:*",
        "@nestjs/testing": "11.1.28",
        "@swc/core": "1.15.47",
        "@types/bcrypt": "6.0.0",
        "@types/node": "26.1.1",
        "@types/passport-jwt": "4.0.1",
        "@types/passport-local": "1.0.38",
        "fastify": "5.10.0",
        "ts-node": "10.9.2",
        "ts-patch": "4.0.1",
        "tsx": "4.23.1",
        "typescript": "6.0.3",
        "unplugin-swc": "1.5.9",
        "vitest": "4.1.10"
    }
}
