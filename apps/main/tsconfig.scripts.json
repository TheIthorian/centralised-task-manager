{
    "extends": "@ctm/tsconfig/nestjs.json",
    "compilerOptions": {
        "outDir": "dist-scripts",
        "rootDir": ".",
        "plugins": [
            {
                "transform": "./scripts/swagger-plugin.cjs",
                "type": "program",
                "options": {
                    "dtoFileNameSuffix": [
                        ".dto.ts"
                    ],
                    "controllerFileNameSuffix": [
                        ".controller.ts"
                    ],
                    "introspectComments": true,
                    "classValidatorShim": true
                }
            }
        ]
    },
    "include": [
        "src/**/*.ts",
        "scripts/**/*.ts"
    ],
    "exclude": [
        "src/**/*.spec.ts",
        "vitest.config.ts",
        "vitest.setup.ts"
    ]
}
