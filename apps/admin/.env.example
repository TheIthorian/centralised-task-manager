MONGODB_URI=mongodb://localhost:27017/ctm
PORT=3100
NODE_ENV=development

# The single operator credential. ADMIN_PASSWORD_HASH is a bcrypt hash — generate it with:
#   node -e "import('bcrypt').then(b => b.default.hash(process.argv[1], 12)).then(console.log)" 'your-password'
# The plaintext password must never appear in the environment of a running server.
ADMIN_USERNAME=operator
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=

# Optional, with the defaults shown.
ADMIN_SESSION_EXPIRES_MINUTES=720
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15

# Origin the admin SPA is served from. The session cookie is credentialed, so this is the only
# allowed CORS origin and there is no wildcard fallback.
ADMIN_WEB_URL=http://localhost:5174
COOKIE_SECURE=false

LOG_LEVEL=info
LOG_PRETTY=true
LOG_REDACT=false
