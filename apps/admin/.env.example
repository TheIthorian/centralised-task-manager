MONGODB_URI=mongodb://localhost:27017/ctm

# The connection is opened per request and closed again after this long with nothing in flight, so
# an idle container sends no traffic and the platform can scale it to zero. Lower means more cold
# starts; higher means the container stays awake longer after a burst of use.
MONGODB_IDLE_TIMEOUT_MS=60000

PORT=3100
NODE_ENV=development

# Cloudflare Access authenticates the operator; this app only verifies what Access signed.
# CF_ACCESS_TEAM_DOMAIN is your team domain, which is both the token issuer and the JWKS host.
# CF_ACCESS_AUD is the Access application's audience tag, from the application's settings.
# Without the audience, a token minted for any other application in the same team verifies here.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=

# Local development only: treats every request as this operator and skips Access entirely.
# The env schema refuses to start when this is set and NODE_ENV=production.
ADMIN_DEV_BYPASS_EMAIL=you@example.com

# Origin the admin SPA is served from. The Access cookie is credentialed, so this is the only
# allowed CORS origin and there is no wildcard fallback.
ADMIN_WEB_URL=http://localhost:5174

LOG_LEVEL=info
LOG_PRETTY=true
LOG_REDACT=false
