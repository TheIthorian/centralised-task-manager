# Where this service calls the API (may be private); where clients reach it (must be public)
CTM_API_BASE_URL=http://localhost:3000
CTM_PUBLIC_URL=http://localhost:3000
MCP_PUBLIC_URL=http://localhost:3002
RSA_PUBLIC_KEY=<base64-encoded RSA public key PEM — same value as apps/main RSA_PUBLIC_KEY>
PORT=3002
NODE_ENV=development
LOG_LEVEL=debug
# Pretty output via pino-pretty. Optional, defaults to false. Must be false when
# NODE_ENV=production: pino-pretty is a devDependency, so a production image does not ship it.
LOG_PRETTY=true
# Redaction of tokens, passwords, cookies and OAuth codes. Optional, defaults to true. Set false
# locally to eyeball a value; the env validator refuses to boot with it off when NODE_ENV=production.
LOG_REDACT=true

# ---------------------------------------------------------------------------
# Production (Railway service: "mcp") — set these as Railway variables.
#
#   PORT=3002
#   CTM_API_BASE_URL=http://${{main.RAILWAY_PRIVATE_DOMAIN}}:3000   # private network
#   CTM_PUBLIC_URL=https://app.<domain>/api                         # must equal the issuer
#                                                                   # main advertises, i.e. its
#                                                                   # REDIRECT_BASE_URL
#   MCP_PUBLIC_URL=https://<mcp>.up.railway.app                     # advertised to MCP clients
#   RSA_PUBLIC_KEY=<same base64 SPKI PEM as the main service>
#   NODE_ENV=production
#   LOG_LEVEL=info
#   LOG_PRETTY=false                                    # required false in production
#   LOG_REDACT=true                                     # required true in production
# ---------------------------------------------------------------------------
