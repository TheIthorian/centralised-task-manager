CTM_API_BASE_URL=http://localhost:3000
MCP_PUBLIC_URL=http://localhost:3002
RSA_PUBLIC_KEY=<base64-encoded RSA public key PEM — same value as apps/main RSA_PUBLIC_KEY>
PORT=3002
NODE_ENV=development

# ---------------------------------------------------------------------------
# Production (Railway service: "mcp") — set these as Railway variables.
#
#   PORT=3002
#   CTM_API_BASE_URL=http://${{main.RAILWAY_PRIVATE_DOMAIN}}:3000   # private network
#   MCP_PUBLIC_URL=https://<mcp>.up.railway.app                     # advertised to MCP clients
#   RSA_PUBLIC_KEY=<same base64 SPKI PEM as the main service>
#   NODE_ENV=production
# ---------------------------------------------------------------------------
