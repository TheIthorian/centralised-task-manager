{
    "name": "@ctm/mcp",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/main.js",
        "dev": "node --watch -r ./register.cjs src/main.ts",
        "test": "vitest run",
        "lint": "oxlint .",
        "format": "oxfmt --no-error-on-unmatched-pattern --config ../../.oxfmtrc.json src '**/*.md'"
    },
    "dependencies": {
        "@ctm/api-client": "workspace:*",
        "@ctm/env": "workspace:*",
        "@ctm/errors": "workspace:*",
        "@ctm/logger": "workspace:*",
        "@ctm/request-logger": "workspace:*",
        "@fastify/cors": "11.3.0",
        "@modelcontextprotocol/sdk": "1.29.0",
        "@nestjs/common": "11.1.28",
        "@nestjs/config": "4.0.4",
        "@nestjs/core": "11.1.28",
        "@nestjs/passport": "11.0.5",
        "@nestjs/platform-fastify": "11.1.28",
        "joi": "18.2.9",
        "passport": "0.7.0",
        "passport-jwt": "4.0.1",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@ctm/tsconfig": "workspace:*",
        "@nestjs/testing": "11.2.1",
        "@swc/core": "1.16.0",
        "@types/node": "26.2.0",
        "@types/passport-jwt": "4.0.1",
        "fastify": "5.12.0",
        "ts-node": "10.9.2",
        "tsx": "4.23.12",
        "typescript": "6.0.3",
        "unplugin-swc": "1.5.11",
        "vitest": "4.1.10"
    }
}
