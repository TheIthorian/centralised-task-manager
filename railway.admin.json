{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "apps/admin/Dockerfile",
        "watchPatterns": [
            "apps/admin/**",
            "packages/api-client/**",
            "packages/connectors/**",
            "packages/db/**",
            "packages/env/**",
            "packages/errors/**",
            "packages/logger/**",
            "packages/nest-common/**",
            "packages/request-logger/**",
            "packages/tsconfig/**",
            "package.json",
            "pnpm-lock.yaml",
            "pnpm-workspace.yaml",
            "turbo.json",
            "railway.admin.json"
        ]
    },
    "deploy": {
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10,
        "numReplicas": 1
    }
}
